{
  "name": "revo-print-shop",
  "version": "1.5.5",
  "description": "Revo Print Shop V1.5.5 — NAS-hosted QR Upload with no desktop tunnel.",
  "main": "bootstrap.js",
  "author": "Revo Print Shop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.yml --win nsis portable --publish never",
    "dist:dir": "electron-builder --config electron-builder.yml --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "^1.5.4",
    "qz-tray": "2.2.6",
    "node-forge": "1.3.1"
  }
}
